# Normalise line endings. Files edited on Windows must never reach Linux with CRLF.
* text=auto

# Anything that runs on Linux must use LF, whatever the contributor's Git settings
*.sh        text eol=lf
*.bash      text eol=lf
*.bats      text eol=lf
*.service   text eol=lf
*.timer     text eol=lf
*.conf      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.j2        text eol=lf
*.json      text eol=lf
*.cfg       text eol=lf
*.ini       text eol=lf
*.env.example text eol=lf

# C++ sources and build files
*.cpp       text eol=lf
*.hpp       text eol=lf
*.h         text eol=lf
*.cmake     text eol=lf
CMakeLists.txt text eol=lf
Makefile    text eol=lf

# Config files that have no extension (Nginx site files, logrotate, sshd drop-ins)
config/**   text eol=lf

# Documentation
*.md        text

# Binary files: never convert or diff as text
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.pdf       binary
*.zip       binary
*.gz        binary
